### MongoDB: อ่านผู้ใช้ทั้งหมด
GET http://localhost:3002/api/v2/users

### MongoDB: สร้างผู้ใช้ใหม่
POST http://localhost:3002/api/v2/users
Content-Type: application/json

{
    "username": "Charlie",
    "email": "charliebrfbo@something.com",
    "password": "pass1234"
}

### MongoDB: สร้างผู้ใช้ใหม่อีกคน
POST http://localhost:3002/api/v2/users
Content-Type: application/json

{
    "username": "David",
    "email": "david@example.com",
    "password": "pass5678"
}

### MongoDB: สร้างผู้ใช้ใหม่อีกคน
POST http://localhost:3002/api/v2/users
Content-Type: application/json

{
    "username": "Emma",
    "email": "emma@example.com",
    "password": "pass9012"
}

### MongoDB: แก้ไข user ตาม id
# วาง MongoDB ObjectId จริงแทนค่า placeholder นี้
PUT http://localhost:3002/api/v2/users/PUT_MONGO_OBJECT_ID_HERE
Content-Type: application/json

{
    "username": "Emma Updated",
    "role": "admin"
}

### MongoDB: ลบ user ตาม id
# วาง MongoDB ObjectId จริงแทนค่า placeholder นี้
DELETE http://localhost:3002/api/v2/users/DELETE_MONGO_OBJECT_ID_HERE
